{
  "expo": {
    "name": "PAYANAM",
    "slug": "payanam",
    "scheme": "payanam",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F6F7F5",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.payanam.mobile",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "PAYANAM uses your location to show bikes near you and guide you to the pickup point."
      }
    },
    "android": {
      "package": "app.payanam.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0E6B5C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#0E6B5C",
          "dark": {
            "backgroundColor": "#0B1215"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "PAYANAM needs your photos to upload documents and bike inspection pictures.",
          "cameraPermission": "PAYANAM uses the camera to capture documents, bike inspection photos and your verification selfie.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "PAYANAM uses your location to show bikes near you and guide you to the pickup point."
        }
      ],
      "expo-asset"
    ]
  }
}

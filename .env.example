# PAYANAM public client configuration (safe to ship in the app bundle).
# Never put service-role keys or third-party secret keys here.

# true  -> everything runs locally with mock services (default)
# false -> uses Supabase for auth, database and storage (requires the URL + anon key below)
EXPO_PUBLIC_DEMO_MODE=true

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
